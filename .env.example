# Copy this file to .env and fill in values. Never commit .env.
# The app works without any of these set (it falls back to template explanations).

# Port the web server listens on.
PORT=8000

# Set to false to skip the Presidio/spaCy NER layer (regex PII rules still run).
# Useful on hosts with little memory.
PII_NER_ENABLED=true

# Anthropic API key for AI explanations. Leave empty to use built-in templates.
ANTHROPIC_API_KEY=
# Claude model used for explanations (default: claude-opus-5-5).
LLM_MODEL=claude-opus-5-5
# Optional tuning: request timeout in seconds (default 15) and effort level (default low).
LLM_TIMEOUT_SECONDS=15
LLM_EFFORT=low

# Requests per minute per client IP for /api endpoints (health excluded).
RATE_LIMIT_PER_MINUTE=30
# Analyses kept in memory at once (default 50). Lower it on hosts with little memory.
MAX_SESSIONS=50
# Development only: enable CORS for a separately served frontend.
DEV_CORS=false
CORS_ORIGINS=http://localhost:5500
# Proxy IPs whose X-Forwarded-For header is trusted (set to * behind a hosting proxy).
FORWARDED_ALLOW_IPS=127.0.0.1
